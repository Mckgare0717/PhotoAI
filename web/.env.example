# Postgres with pgvector enabled
DATABASE_URL=postgres://photoai:photoai@localhost:5432/photoai

# Face-recognition microservice
ML_SERVICE_URL=http://localhost:8000

# Local file storage root (swap for S3/R2 later via lib/storage.ts)
STORAGE_DIR=../storage

# Photographer/admin login
ADMIN_PASSWORD=change-me

# Secret for session cookies and signed file URLs (use a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL used in QR codes / share links
NEXT_PUBLIC_BASE_URL=http://localhost:3000
